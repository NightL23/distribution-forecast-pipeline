# ═══════════════════════════════════════════════════════════════
# Multi-Model Distribution Forecast Pipeline — .env
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
# Total calls = N_DRAWS × firms × enabled_providers

# ── Draws per firm per model ─────────────────────────────────
N_DRAWS=100

# ── OpenAI ───────────────────────────────────────────────────
ENABLE_OPENAI=true
OPENAI_API_KEY=sk-proj-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_COMPLETION_TOKENS=400
OPENAI_TEMPERATURE=0.7
# Max simultaneous requests to OpenAI
OPENAI_CONCURRENCY=50

# ── Anthropic (Claude) ──────────────────────────────────────
ENABLE_ANTHROPIC=true
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=400
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_CONCURRENCY=40

# ── Google Gemini ────────────────────────────────────────────
ENABLE_GEMINI=true
GEMINI_API_KEY=AIza-CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_TEMPERATURE=0.7
GEMINI_CONCURRENCY=50

# ── Source data API (from professor) ─────────────────────────
DATA_API_URL=https://api.yowlo.app/v1/zip/download/
DATA_API_METHOD=GET
DATA_API_TIMEOUT_SECONDS=300

DATA_API_HEADERS_JSON={}
DATA_API_PARAMS_JSON={}
DATA_API_BODY_JSON={}

DATA_API_BEARER_TOKEN=
DATA_API_KEY_HEADER_NAME=X-Custom-Auth
DATA_API_KEY=pA6cbPYocPEDikAJ4AjsuHYA6cKup7jg

# ZIP / nested payload options
DATA_API_ZIP_MEMBER=data_standardized
DATA_API_RECORDS_PATH=
DATA_API_SHEET_NAME=

# ── Forecast controls ────────────────────────────────────────
FORECAST_PERIOD=2026Q1
MAX_COMPANIES_PER_RUN=0
PROMPT_MAX_HISTORY_POINTS=4
PROMPT_MAX_NOTE_CHARS=160
PROMPT_MAX_COMPANY_CONTEXT_CHARS=600
PROMPT_INCLUDE_EPS_HISTORY=true
TIMEZONE_NAME=America/Los_Angeles
SOURCE_API_SAVE_RAW=true

# ── Local output ─────────────────────────────────────────────
LOCAL_OUTPUT_DIR=./output

# ── Google Drive ─────────────────────────────────────────────
GOOGLE_DRIVE_CREDENTIALS_FILE=./credentials.json
GOOGLE_DRIVE_TOKEN_FILE=./token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=nightly_forecasts
